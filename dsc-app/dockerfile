FROM node:20-alpine AS builder

# Install pnpm via corepack (built into Node 20)
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./

RUN pnpm install

COPY . .

# Write build-time env vars to .env file (avoids ARG/ENV warnings)
# These are NOT secrets - they get baked into the public JS bundle
ARG VITE_REACT_APP_API_BASE_URL
ARG VITE_REACT_APP_EDITOR_KEY
ARG VITE_PORT
RUN printf "VITE_REACT_APP_API_BASE_URL=%s\nVITE_REACT_APP_EDITOR_KEY=%s\nVITE_PORT=%s\n" \
    "$VITE_REACT_APP_API_BASE_URL" "$VITE_REACT_APP_EDITOR_KEY" "$VITE_PORT" > .env

RUN pnpm run build

# Production stage - use smaller image
FROM node:20-alpine

RUN npm install -g serve

WORKDIR /app

COPY --from=builder /app/dist ./dist

EXPOSE 5000

CMD ["serve", "-s", "dist", "-l", "5000"]
